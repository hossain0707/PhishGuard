{
  "name": "phishguard-fyp",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --env-file-if-exists=.env tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run format:check && npm run build && npm test && npm run lint:extension && npm run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:extension": "addons-linter dist/firefox --warnings-as-errors",
    "demo": "npm run build && node tools/demo.mjs && node tools/make-demo-animation.mjs",
    "serve": "node tools/serve.mjs",
    "evaluate": "node tools/evaluate.mjs",
    "audit:all": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "addons-linter": "10.14.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
